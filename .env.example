# Postgres. Vercel sets this from the Neon integration. Locally:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/epw_dev
# Long random string: openssl rand -hex 32
PAYLOAD_SECRET=
# Set automatically when the Vercel Blob store is connected. Leave empty locally (uploads go to ./media).
BLOB_READ_WRITE_TOKEN=
# The private Blob store for manuscript uploads (connect it with the env prefix MANUSCRIPTS).
# Without it the manuscript form takes no file and says to send it by email.
MANUSCRIPTS_READ_WRITE_TOKEN=
# Random 32-character hex string for IndexNow: openssl rand -hex 16
INDEXNOW_KEY=
# Integration tests use their own database (wiped on each run):
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/epw_test
# The only email that can create the first admin account (before anyone is signed in):
ADMIN_SETUP_EMAIL=
# Optional: put the whole site behind a password (development only; leave empty locally):
SITE_PASSWORD=
# Optional, previews only: serve the compiled Markdown instead of the CMS (no database needed;
# the admin doesn't work). The build refuses it on production.
CONTENT_SOURCE=
# Form email via Resend. The sending domain must be verified in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Spam filter (src/lib/spam/, the controller used on bluetowerroofs.com and the Orion site): rate
# limit, bot traps, pitch rules, and an optional Claude check. Use this site's own Claude API key,
# not another site's. Without it the bot traps and pitch rules still run.
ANTHROPIC_API_KEY=
# Only for a key that isn't scoped to a workspace: the workspace ID to send with each request.
ANTHROPIC_WORKSPACE_ID=
# SPAM_FILTER=off turns the pitch rules and AI check off (bot traps stay on).
SPAM_FILTER=
# SPAM_AI_MODEL overrides the model the AI check uses (default claude-opus-5-5).
SPAM_AI_MODEL=
# Where flagged submissions go, marked [spam] with the reason (so a false positive is never lost).
# Without it they are dropped and only the verdict is logged.
SPAM_TO_EMAIL=
# Google Analytics 4 measurement ID (G-…), Vercel Production only; loads only when VERCEL_ENV=production.
# The WordPress site loaded Google tag GT-K4VMCWDN through Site Kit; the G- ID behind it is in GA admin.
NEXT_PUBLIC_GA_ID=
